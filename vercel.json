{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/nexa-traders run build",
  "outputDirectory": "artifacts/nexa-traders/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
